// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PETUGAS
  UNIVERSITAS
}

enum StatusVerifikasi {
  PENDING
  APPROVED
  REJECTED
}

enum KondisiBarang {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
}

enum StatusBarang {
  TERSEDIA
  DIPINJAM
  MAINTENANCE
}

enum StatusTransaksi {
  AKTIF
  SELESAI
  TERLAMBAT
}

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String           @unique
  password         String?
  image            String?
  provider         String           @default("credentials")
  role             Role             @default(PETUGAS)
  statusVerifikasi StatusVerifikasi @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  transaksi Transaksi[]

  @@map("users")
}

model KategoriBarang {
  id        String   @id @default(cuid())
  nama      String   @unique
  deskripsi String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barang Barang[]

  @@map("kategori_barang")
}

model Ruangan {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  gedung    String?
  lantai    String?
  kapasitas Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barang Barang[]

  @@map("ruangan")
}

model Barang {
  id         String        @id @default(cuid())
  kodeBarang String        @unique
  nama       String
  deskripsi  String?
  kondisi    KondisiBarang @default(BAIK)
  status     StatusBarang  @default(TERSEDIA)
  jumlah     Int           @default(1)
  tahunBeli  Int?
  harga      Float?
  qrCode     String?       @db.Text
  foto       String?
  kategoriId String
  ruanganId  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  kategori  KategoriBarang @relation(fields: [kategoriId], references: [id])
  ruangan   Ruangan?       @relation(fields: [ruanganId], references: [id])
  transaksi Transaksi[]

  @@map("barang")
}

model Transaksi {
  id              String          @id @default(cuid())
  barangId        String
  userId          String
  tanggalPinjam   DateTime        @default(now())
  tanggalKembali  DateTime?
  deadlineKembali DateTime
  status          StatusTransaksi @default(AKTIF)
  catatan         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  barang Barang @relation(fields: [barangId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("transaksi")
}
