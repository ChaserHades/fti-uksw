// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEKNISI
  UNIVERSITAS
}

enum StatusVerifikasi {
  PENDING
  APPROVED
  REJECTED
}

enum KondisiBarang {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
}

enum StatusBarang {
  TERSEDIA
  DIPINJAM
  MAINTENANCE
}

enum StatusTransaksi {
  AKTIF
  SELESAI
}

enum JenisPengeluaran {
  PEMBELIAN_ASET
  MAINTENANCE
  LAINNYA
}

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String           @unique
  password         String?
  provider         String           @default("credentials")
  role               Role             @default(TEKNISI)
  statusVerifikasi   StatusVerifikasi @default(PENDING)
  mustChangePassword Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  transaksi          Transaksi[]
  pengeluaran      Pengeluaran[]

  @@map("users")
}

model KategoriBarang {
  id        String   @id @default(cuid())
  nama      String   @unique
  deskripsi String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  barang    Barang[]

  @@map("kategori_barang")
}

model Ruangan {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  lantai    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  barang    Barang[]

  @@map("ruangan")
}

model Barang {
  id           String         @id @default(cuid())
  kodeBarang   String         @unique
  nama         String
  serialNumber String?
  merek        String?
  tipe         String?
  vendor       String?
  deskripsi    String?
  kondisi      KondisiBarang  @default(BAIK)
  status       StatusBarang   @default(TERSEDIA)
  jumlah       Int            @default(1)
  tanggalBeli  DateTime?
  harga        Float?
  /// true = barang punya sticker/barcode fisik (diregister via scan)
  hasSticker   Boolean        @default(false)
  /// QR image data URL — hanya ada jika di-generate dari sistem
  qrCode       String?
  foto         String?
  kategoriId  String
  ruanganId   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  kategori    KategoriBarang @relation(fields: [kategoriId], references: [id])
  ruangan     Ruangan?       @relation(fields: [ruanganId], references: [id])
  transaksi   Transaksi[]

  @@map("barang")
}

model Transaksi {
  id              String          @id @default(cuid())
  barangId        String
  userId          String
  /// Peminjam aktual (mahasiswa/dosen/staf) — diisi petugas via modal
  namaPeminjam    String
  /// Ruangan tujuan penggunaan — free-text
  ruanganPinjam   String
  tanggalPinjam   DateTime        @default(now())
  tanggalKembali  DateTime?
  deadlineKembali DateTime
  status          StatusTransaksi @default(AKTIF)
  /// Persisten: true jika pernah melewati deadline, tidak di-reset saat dikembalikan
  terlambat       Boolean         @default(false)
  catatan         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  barang          Barang          @relation(fields: [barangId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@map("transaksi")
}

model Pengeluaran {
  id          String             @id @default(cuid())
  judul       String
  deskripsi   String?
  nominal     Float
  tanggal     DateTime
  jenis       JenisPengeluaran
  /// Path ke file nota/receipt (opsional)
  notaUrl     String?
  userId      String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id])

  @@map("pengeluaran")
}
